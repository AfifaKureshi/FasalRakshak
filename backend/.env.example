# Server configuration
PROJECT_NAME="FasalRakshak API"
API_V1_STR="/api/v1"
SECRET_KEY="fasalrakshak_prototype_secret_key_change_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL with fallback to SQLite for local development)
DATABASE_URL="sqlite:///./fasalrakshak.db"
# Example PostgreSQL with PostGIS:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fasalrakshak"

# Uploads
UPLOAD_DIR="./uploads"

# Model configuration
MODEL_CPU_THREADS=4
USE_MOCK_ML_FALLBACK=true
